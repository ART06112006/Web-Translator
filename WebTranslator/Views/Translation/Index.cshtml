    <div class="d-flex flex-row align-items-center justify-content-between mt-2 ms-5 me-5">
        <div class="form-floating col-5" style="height: 300px">
            <textarea class="form-control" placeholder="Leave a comment here" id="inputText" style="height: 100%; resize: none"></textarea>
            <label for="inputText">Enter Text</label>
        </div>

        <div class="form-floating col-5" style="height: 300px">
            <textarea class="form-control" placeholder="Translation" id="outputText" style="height: 100%; resize: none" disabled></textarea>
            <label for="outputText">Translation</label>
        </div>
    </div>
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        function translate() {
            let text = $('#inputText').val();
            let from = $('#fromLang').val();
            let to = $('#toLang').val();

            let data = {
                text: text,
                from: from,
                to: to
            };

            $.ajax({
                url: "https://localhost:7251/api/ApiTranslator/Translate?" + $.param(data),
                type: "GET",
                success: function (response) {
                    $('#outputText').val(response)
                },
                error: function (xhr, status, error) {
                    $('#outputText').val(error)
                }
            });
        }


        $('#inputText').on('input', function () {
            translate();
        });

        $('#fromLang').on('input', function () {
            translate();
        });

        $('#toLang').on('input', function () {
            translate();
        });
    });
</script>